{
  "name": "vero",
  "version": "1.0.0",
  "description": "Vero \u2014 MV3 extension that notices e-commerce persuasion patterns and asks Socratic questions about them.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "postinstall": "wxt prepare",
    "fixtures:scan": "tsx scripts/scan-fixtures.ts",
    "fixtures:normalize": "tsx scripts/normalize-fixture.ts",
    "test:e2e": "playwright test",
    "measure:perf": "node scripts/measure-perf.mjs",
    "corpus:collect": "node scripts/collect-corpus.mjs",
    "label": "node scripts/label.mjs",
    "corpus:train": "tsx scripts/train-classifier.ts",
    "corpus:ingest": "node scripts/ingest-auto-labels.mjs",
    "corpus:export": "node scripts/export-for-labelling.mjs",
    "eval:detectors": "vitest run tests/eval/detector-recall.test.ts",
    "corpus:merge": "node scripts/merge-corpus.mjs",
    "spot:check": "node scripts/spot-check.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "dataset": "node scripts/dataset.mjs",
    "sink:deploy": "wrangler deploy --config server/cloudflare/wrangler.toml",
    "sink:schema": "wrangler d1 execute vero-counts --remote --config server/cloudflare/wrangler.toml --file server/cloudflare/schema.sql"
  },
  "author": "Vidit Chhajed",
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "dexie": "4.4.5",
    "preact": "10.29.8",
    "wxt": "0.21.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@types/chrome": "0.2.9",
    "@types/node": "26.4.1",
    "jsdom": "30.0.1",
    "playwright": "1.63.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
